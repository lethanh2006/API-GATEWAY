# Gateway Server Configuration
NODE_ENV=development
PORT=3000

# Upstream Microservices URLs
AUTH_SERVICE_URL=http://localhost:4000
USER_SERVICE_URL=http://localhost:5000
CHAT_SERVICE_URL=http://localhost:5002
TODO_SERVICE_URL=http://localhost:5003
WORKSCHEDULE_SERVICE_URL=http://localhost:5004
CANTEEN_SERVICE_URL=http://localhost:5005
PAYMENT_SERVICE_URL=http://localhost:5006

# Security & Authentication
JWT_SECRET=replace_with_at_least_32_random_characters
# Có thể tách riêng hai secret dưới đây; nếu bỏ trống, Gateway dùng JWT_SECRET
# để giữ tương thích cấu hình hiện tại.
AUTH_INTERNAL_SECRET=
USER_INTERNAL_SECRET=
CANTEEN_INTERNAL_SECRET=replace_with_a_long_random_shared_secret
PAYMENT_INTERNAL_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_PAYMENT_SECRET

# Basic Gateway rate limit (per instance; use Redis/Ingress when scaling)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# Centralized Swagger UI Configuration
TITLE_SWAGGER=Centralized API Gateway
CONTENT_SWAGGER=API Gateway for Microservices
VERSION_SWAGGER=1.0.0
ENDPOINT_SWAGGER=api-docs
